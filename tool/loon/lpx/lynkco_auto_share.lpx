#!name=领克每日签到与分享诊断
#!desc=领克账号凭证生命周期巡检、每日签到状态检测、文章分享链路连通性诊断，支持 PushPlus 微信推送
#!author=swsv
#!homepage=https://github.com/swsv/network-toolkit
#!system=iOS,iPadOS,macOS
#!loon_version=3.2.1
#!tag=领克,签到,分享诊断,PushPlus

[Argument]
pushToken = input,"",tag=PushPlus Token,desc=PushPlus 网站获取的一对一 Token(用于微信推送)
pushTopic = input,"",tag=PushPlus 群组(可选),desc=群组编码(若填则推送到群组，不填则一对一推送)
notifyOnSuccess = switch,true,tag=Loon 本地通知,desc=诊断任务执行完成后是否弹出系统本地通知

[Script]
http-request ^https:\/\/app-services\.lynkco\.com\.cn\/auth\/(login\/.*|oauth2\/.*) script-path=https://raw.githubusercontent.com/swsv/network-toolkit/redpanda/scripts/lynkco/auto_share.js, requires-body=false, timeout=30, tag=领克抓LoginRequest, enable=true

http-response ^https:\/\/app-services\.lynkco\.com\.cn\/auth\/(login\/.*|oauth2\/.*) script-path=https://raw.githubusercontent.com/swsv/network-toolkit/redpanda/scripts/lynkco/auto_share.js, requires-body=true, timeout=30, tag=领克抓LoginResponse, enable=true

cron "26 8,20 * * *" script-path=https://raw.githubusercontent.com/swsv/network-toolkit/redpanda/scripts/lynkco/auto_share.js, timeout=90, tag=领克每日签到与分享诊断, argument=[{pushToken},{pushTopic},{notifyOnSuccess}], enable=true

[MITM]
hostname = h5-api.lynkco.com, h5.lynkco.com, app-services.lynkco.com.cn, app-api-gw-toc.lynkco.com
